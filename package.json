{
  "name": "claude-conversation-reader",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server and CLI tool to read Claude.ai conversation threads and inject them as context into VS Code Copilot",
  "main": "dist/index.js",
  "bin": {
    "ccr": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:server": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:server": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "install-hooks": "git config core.hooksPath .githooks"
  },
  "keywords": [
    "claude",
    "conversation",
    "mcp",
    "copilot",
    "context"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@napi-rs/canvas": "^0.1.100",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dotenv": "^17.4.1",
    "ora": "^9.3.0",
    "pdfjs-dist": "^3.11.174",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "vis-network": "^9.1.9",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "chrome-remote-interface": "^0.34.0",
    "eslint": "^9.39.4",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^2.1.9"
  }
}
