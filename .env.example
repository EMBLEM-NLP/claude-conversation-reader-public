# Claude.ai credentials are handled via browser login (Playwright).
# No API keys needed for most commands — authentication uses session cookies.

# Optional: Override session file location (default: ~/.ccr/session.json)
# SESSION_PATH=/custom/path/session.json

# Required for: rename-project-conversations (AI title generation via Claude Haiku)
# Get your key at: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
